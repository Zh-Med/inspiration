# Upload allowlist. Local REA, evidence media, data, credentials and runtime files stay local.
/*
!/.gitignore
!/README.md
!/package.json
!/app/
!/server/
!/scripts/
!/tests/
!/docs/
!/.github/
/app/*
!/app/*.js
!/app/*.css
!/app/*.html
!/app/*.webmanifest
!/app/icon.svg
!/app/icon-192.png
!/app/icon-512.png
!/app/paper-*.webp
/server/*
!/server/*.mjs
/scripts/*
!/scripts/collect.mjs
!/scripts/worker.mjs
!/scripts/serve.mjs
!/scripts/preview-phone.mjs
!/scripts/check-server.mjs
!/scripts/build-pages.mjs
!/scripts/bake-paper-materials.cjs
!/scripts/parse-feed.py
!/scripts/parse-newsroom.py
/tests/*
!/tests/*.test.mjs
/docs/*
!/docs/DEPLOYMENT.md
!/docs/BACKEND.md
!/docs/NEWS-COVERAGE.md
!/docs/PERFORMANCE.md
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/*.yml
# These exclusions win even inside allowed source directories.
**/.env
**/.env.*
**/*key*
**/*.pem
**/*.p12
**/*.enc
**/node_modules/
**/__pycache__/
**/.DS_Store
